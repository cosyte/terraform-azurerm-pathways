# Azure Monitor alerts on five of the metrics the engine serves at /metrics on its health endpoint,
# and what it takes to read them on Container Apps:
#
#   * a bearer token for the health endpoint, generated by an ephemeral resource and written in a
#     write-only argument to a Key Vault secret, so neither the plan nor the state holds it. The app
#     reads it into the engine (PATHWAYS_HEALTH_TOKEN, which the health endpoint reads by default)
#     and into the collector, so /metrics stays authenticated;
#   * a workspace-based Application Insights resource on the deployment's Log Analytics workspace,
#     which takes the metrics, and its connection string as a second Key Vault secret, which only the
#     collector reads;
#   * the configuration of an OpenTelemetry collector that runs beside the engine in each replica
#     (the container_apps module adds the container): it scrapes /metrics at 127.0.0.1 every 30
#     seconds, keeps the five families the alerts read and drops every other, sums or takes the
#     extreme over every channel, destination and outcome label so no channel or destination name
#     leaves the replica, turns the two counters into what was added since the previous scrape, and
#     sends them to Application Insights, which keeps them as custom metrics;
#   * five metric alerts on those custom metrics, each calling the caller's action group when it
#     fires and when it resolves.
#
# The custom metrics, in the azure.applicationinsights namespace of the Application Insights
# resource:
#
#   pathways_store_up                     the minimum: 0 when the engine could not read its database
#   pathways_oldest_pending_age_seconds   the maximum over every destination
#   pathways_queue_depth                  the deliveries pending, summed over every destination
#   pathways_messages_refused_total       the bodies refused since the last scrape, every channel
#   pathways_settled_destinations_total   the settlements with outcome "failed" since the last
#                                         scrape, every channel and destination

locals {
  metric_namespace           = "azure.applicationinsights"
  dimension                  = "Deployment"
  token_variable             = "PATHWAYS_HEALTH_TOKEN"
  connection_string_variable = "APPLICATIONINSIGHTS_CONNECTION_STRING"

  # Each family the alerts read, as the collector may name it (with or without the _total or unit
  # suffix, as its Prometheus receiver normalizes names or not), the name it gets in Azure Monitor,
  # how its label sets fold into one, and whether it is a counter.
  families = {
    store_up = {
      names       = ["pathways_store_up"]
      match       = "^pathways_store_up"
      metric_name = "pathways_store_up"
      aggregation = "min"
      counter     = false
    }
    oldest_pending_age = {
      names       = ["pathways_oldest_pending_age_seconds", "pathways_oldest_pending_age"]
      match       = "^pathways_oldest_pending_age"
      metric_name = "pathways_oldest_pending_age_seconds"
      aggregation = "max"
      counter     = false
    }
    queue_depth = {
      names       = ["pathways_queue_depth"]
      match       = "^pathways_queue_depth"
      metric_name = "pathways_queue_depth"
      aggregation = "sum"
      counter     = false
    }
    messages_refused = {
      names       = ["pathways_messages_refused_total", "pathways_messages_refused"]
      match       = "^pathways_messages_refused"
      metric_name = "pathways_messages_refused_total"
      aggregation = "sum"
      counter     = true
    }
    settled_destinations = {
      names       = ["pathways_settled_destinations_total", "pathways_settled_destinations"]
      match       = "^pathways_settled_destinations"
      metric_name = "pathways_settled_destinations_total"
      aggregation = "sum"
      counter     = true
    }
  }

  kept_names = flatten([for f in values(local.families) : f.names])
  settled_condition = join(" or ", [
    for n in local.families.settled_destinations.names : "metric.name == \"${n}\""
  ])
  counter_names = sort([for f in values(local.families) : f.metric_name if f.counter])

  # The collector's whole configuration. It names the token and the connection string only as the
  # variables the collector reads them from, never their values.
  collector_config = yamlencode({
    receivers = {
      prometheus = {
        config = {
          scrape_configs = [{
            job_name        = "pathways"
            scrape_interval = "30s"
            scrape_timeout  = "10s"
            metrics_path    = "/metrics"
            scheme          = "http"
            authorization = {
              type        = "Bearer"
              credentials = "$${env:${local.token_variable}}"
            }
            static_configs = [{ targets = ["127.0.0.1:${var.health_port}"] }]
          }]
        }
      }
    }

    processors = {
      # Only the five families leave the replica, and of the settlements only those that failed.
      "filter/pathways" = {
        error_mode = "ignore"
        metrics = {
          metric = [
            "not (${join(" or ", [for n in local.kept_names : "name == \"${n}\""])})",
          ]
          datapoint = [
            "(${local.settled_condition}) and attributes[\"outcome\"] != \"failed\"",
          ]
        }
      }

      # Each family under one fixed name, its channel, destination and outcome labels folded away,
      # and the deployment's name as its one label.
      "metricstransform/pathways" = {
        transforms = [
          for key in sort(keys(local.families)) : {
            include    = local.families[key].match
            match_type = "regexp"
            action     = "update"
            new_name   = local.families[key].metric_name
            operations = [
              {
                action    = "add_label"
                new_label = local.dimension
                new_value = var.name
              },
              {
                action           = "aggregate_labels"
                label_set        = [local.dimension]
                aggregation_type = local.families[key].aggregation
              },
            ]
          }
        ]
      }

      # Application Insights keeps each value it gets: a counter goes as what was added since the
      # previous scrape, so a total over a window is how many in that window.
      "cumulativetodelta/pathways" = {
        include = {
          metrics    = local.counter_names
          match_type = "strict"
        }
      }

      batch = {
        timeout = "30s"
      }
    }

    exporters = {
      azuremonitor = {
        connection_string = "$${env:${local.connection_string_variable}}"
      }
    }

    service = {
      pipelines = {
        metrics = {
          receivers  = ["prometheus"]
          processors = ["filter/pathways", "metricstransform/pathways", "cumulativetodelta/pathways", "batch"]
          exporters  = ["azuremonitor"]
        }
      }
    }
  })

  # Azure takes a metric alert's window only from a fixed list.
  store_down_window = {
    1  = "PT1M"
    5  = "PT5M"
    15 = "PT15M"
    30 = "PT30M"
    60 = "PT1H"
  }[var.store_down_minutes]

  alerts = {
    # The engine could not read its database for the whole window: no reading in it was 1.
    store_down = {
      description = "Pathways ${var.name}: the engine could not read its database (pathways_store_up below 1) for ${var.store_down_minutes} minute(s). A stopped engine or collector sends nothing, and Azure does not fire a metric alert on missing data."
      metric_name = local.families.store_up.metric_name
      aggregation = "Maximum"
      operator    = "LessThan"
      threshold   = 1
      window_size = local.store_down_window
      frequency   = "PT1M"
      severity    = 1
    }
    # A delivery has waited too long on some destination: it rises while a destination is down or
    # refusing, whatever the traffic. Every reading in the window was above the threshold.
    oldest_pending_age = {
      description = "Pathways ${var.name}: a delivery has waited more than ${var.oldest_pending_age_seconds} seconds on a destination for 5 minutes (pathways_oldest_pending_age_seconds)."
      metric_name = local.families.oldest_pending_age.metric_name
      aggregation = "Minimum"
      operator    = "GreaterThan"
      threshold   = var.oldest_pending_age_seconds
      window_size = "PT5M"
      frequency   = "PT1M"
      severity    = 2
    }
    # More deliveries pending than the threshold, over every destination, for the whole window.
    queue_depth = {
      description = "Pathways ${var.name}: more than ${var.queue_depth_threshold} deliveries have been pending, over every destination, for 5 minutes (pathways_queue_depth)."
      metric_name = local.families.queue_depth.metric_name
      aggregation = "Minimum"
      operator    = "GreaterThan"
      threshold   = var.queue_depth_threshold
      window_size = "PT5M"
      frequency   = "PT1M"
      severity    = 2
    }
    refused_messages = {
      description = "Pathways ${var.name}: the sources refused more than ${var.refused_messages_threshold} bodies (unreadable or rejected) in 15 minutes (pathways_messages_refused_total)."
      metric_name = local.families.messages_refused.metric_name
      aggregation = "Total"
      operator    = "GreaterThan"
      threshold   = var.refused_messages_threshold
      window_size = "PT15M"
      frequency   = "PT5M"
      severity    = 2
    }
    settled_failed = {
      description = "Pathways ${var.name}: more than ${var.settled_failed_threshold} messages settled as failed with a destination in 15 minutes (pathways_settled_destinations_total, outcome failed)."
      metric_name = local.families.settled_destinations.metric_name
      aggregation = "Total"
      operator    = "GreaterThan"
      threshold   = var.settled_failed_threshold
      window_size = "PT15M"
      frequency   = "PT5M"
      severity    = 2
    }
  }
}

# Workspace-based: the metrics' raw values land in the deployment's workspace, under its retention.
# The collector signs in with the connection string, so local authentication stays on; the
# connection string lets a caller send telemetry and read nothing.
resource "azurerm_application_insights" "this" {
  name                = "appi-${var.name}"
  resource_group_name = var.resource_group_name
  location            = var.location
  workspace_id        = var.log_analytics_workspace_id
  application_type    = "other"
  tags                = var.tags
}

ephemeral "random_password" "health_token" {
  length  = 48
  special = false
}

resource "azurerm_key_vault_secret" "health_token" {
  name             = "pathways-health-token"
  key_vault_id     = var.key_vault_id
  content_type     = "text/plain"
  value_wo         = ephemeral.random_password.health_token.result
  value_wo_version = var.health_token_version
  tags             = var.tags
}

# The connection string is in the state already, as an attribute of the Application Insights
# resource, so it is written as a plain value: a new resource writes its new string.
resource "azurerm_key_vault_secret" "connection_string" {
  name         = "pathways-metrics-connection-string"
  key_vault_id = var.key_vault_id
  content_type = "text/plain"
  value        = azurerm_application_insights.this.connection_string
  tags         = var.tags
}

resource "azurerm_monitor_metric_alert" "this" {
  for_each = local.alerts

  name                = "pathways-${var.name}-${replace(each.key, "_", "-")}"
  resource_group_name = var.resource_group_name
  scopes              = [azurerm_application_insights.this.id]
  description         = each.value.description
  severity            = each.value.severity
  frequency           = each.value.frequency
  window_size         = each.value.window_size
  auto_mitigate       = true
  tags                = var.tags

  criteria {
    metric_namespace = local.metric_namespace
    metric_name      = each.value.metric_name
    aggregation      = each.value.aggregation
    operator         = each.value.operator
    threshold        = each.value.threshold
    # The metric exists only once the collector has sent it, after the first apply.
    skip_metric_validation = true
  }

  action {
    action_group_id = var.action_group_id
  }
}
